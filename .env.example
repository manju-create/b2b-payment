# RecoverFlow — environment variables
# Copy this file to .env and fill in your values
# Never commit .env to git

DEEPSEEK_API_KEY=

# Razorpay credentials (required for real payment links)
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook secret (set this in Razorpay Dashboard → Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_string

# Public URL for webhook callbacks (set to your ngrok URL in dev)
# See docs/webhook_setup.md for instructions
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io
